{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Verify PR originates from dev"
          },
          {
            "context": "Unit Tests & Coverage"
          },
          {
            "context": "SAST - SonarCloud Quality Gate"
          },
          {
            "context": "SAST - CodeQL (javascript-typescript)"
          },
          {
            "context": "SAST & Container - Snyk Security"
          },
          {
            "context": "Container - Hadolint, Syft SBOM & Grype"
          },
          {
            "context": "DAST - OWASP ZAP API Scan"
          }
        ]
      }
    }
  ]
}
