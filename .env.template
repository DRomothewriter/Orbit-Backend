PORT = tu_puerto
MONGO_URI = url de base de datos de mongo
JWT_SECRET = Tu palabra random para encriptar

# AWS S3 para almacenamiento de archivos
S3_ACCESS_KEY=tu_access_key
S3_SECRET_KEY=tu_secret_key
S3_REGION=tu_region

# Google OAuth
GOOGLE_ID=tu_google_client_id
GOOGLE_CLIENT_ID=tu_google_client_id

# URL del frontend (sin / al final)
FRONTEND_URL=https://orbit.diego-romo-dev.com

# Orígenes permitidos para CORS (separados por coma, opcional)
ALLOWED_ORIGINS=https://orbit.diego-romo-dev.com,http://localhost:4200

# Email de remitente para correos del sistema
FROM_EMAIL=noreply@orbit.com

# Configuración SMTP (obligatoria para enviar correos reales)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Mediasoup WebRTC (videollamadas)
MEDIASOUP_LISTEN_IP=0.0.0.0

# IP anunciada a clientes WebRTC (announcedAddress):
# - Desarrollo local: 127.0.0.1
# - Producción (AWS EC2): Elastic IP pública de la instancia EC2
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Rango de puertos UDP para WebRTC (debe abrirse en el Security Group de AWS: UDP 10000-10100)
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100